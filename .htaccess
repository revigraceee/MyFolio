# .htaccess - MyFolio Apache Configuration
# Prevent directory listing
Options -Indexes

# Protect sensitive files
<FilesMatch "(\.sql|\.md|database\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Character encoding
AddDefaultCharset UTF-8

